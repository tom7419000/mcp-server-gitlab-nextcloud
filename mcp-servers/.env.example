# Kopieren nach .env und mit echten Werten befüllen.
# .env wird NIEMALS committet und NIEMALS ins Docker-Image gebacken -
# docker-compose liest die Datei zur Laufzeit über `env_file`.

# --- gitlab-mcp ---------------------------------------------------------

# Basis-URL der selbst gehosteten GitLab-CE-Instanz (ohne trailing slash)
GITLAB_URL=https://gitlab.example.com

# Personal Access Token mit Scopes: read_api, read_repository
# Erstellung: GitLab -> Avatar -> Edit Profile -> Access Tokens
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Shared Secret, das MCP-Clients per "Authorization: Bearer <token>" mitschicken
# muessen. Mit z.B. `openssl rand -hex 32` generieren.
GITLAB_MCP_AUTH_TOKEN=change-me-long-random-string

# Port, auf dem der gitlab-mcp Container lauscht (intern und auf dem Host)
GITLAB_MCP_PORT=3001

# --- nextcloud-mcp -------------------------------------------------------

# Basis-URL der Nextcloud-Instanz (ohne trailing slash)
NEXTCLOUD_URL=https://cloud.example.com

# Nextcloud-Benutzername, unter dem die App-Passwort-Session laeuft
NEXTCLOUD_USER=mcp-reader

# App-Passwort (NICHT das Hauptpasswort!)
# Erstellung: Nextcloud -> Einstellungen -> Sicherheit -> App-Passwoerter
NEXTCLOUD_APP_PASSWORD=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shared Secret fuer eingehende MCP-Requests (siehe GITLAB_MCP_AUTH_TOKEN oben)
NEXTCLOUD_MCP_AUTH_TOKEN=change-me-long-random-string

# Port, auf dem der nextcloud-mcp Container lauscht
NEXTCLOUD_MCP_PORT=3002
